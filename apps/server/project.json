{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "bun build apps/server/src/main.ts --target=bun --outdir=dist/apps/server --external=@colyseus/*",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/server"]
    },
    "serve": {
      "command": "bun --watch apps/server/src/main.ts",
      "continuous": true
    },
    "docker-build": {
      "command": "docker build -f apps/server/Dockerfile . -t server"
    }
  }
}
